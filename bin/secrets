#!/usr/bin/env python3
"""Set the five Actions secrets of the signed DMG workflow on the
public repo, default leok7v/Caffeinate.

    bin/secrets <DeveloperID.p12> [<owner/repo>]

The script asks for the .p12 password, the Apple ID and an
app-specific password, checks them, and only then sets the secrets.
"""

from __future__ import annotations

import base64
import getpass
import os
import pathlib
import re
import secrets
import subprocess
import sys

REPO = "leok7v/Caffeinate"
TEAM = re.compile(r"Developer ID Application: [^/\n]*\((\w{10})\)")


def repo_exists(repo):
    run = subprocess.run(["gh", "repo", "view", repo, "--json", "name"],
                         capture_output=True, text=True)
    return run.returncode == 0


def ask():
    return {
        "p12_pwd": getpass.getpass("p12 password: "),
        "apple_id": input("Apple ID: ").strip(),
        "app_pwd": getpass.getpass("app-specific password: ").strip(),
    }


def certificates(p12, pwd):
    text = ""
    for extra in ([], ["-legacy"]):
        if not text:
            run = subprocess.run(["openssl", "pkcs12", "-in", str(p12),
                                  "-nokeys", "-clcerts",
                                  "-passin", "env:P12_PWD", *extra],
                                 env={**os.environ, "P12_PWD": pwd},
                                 capture_output=True, text=True)
            text = run.stdout if run.returncode == 0 else ""
    return text


def team_of(text):
    match = TEAM.search(text)
    return match.group(1) if match else ""


def notary_accepts(given, team):
    run = subprocess.run(["xcrun", "notarytool", "history",
                          "--apple-id", given["apple_id"],
                          "--password", given["app_pwd"],
                          "--team-id", team, "--output-format", "json"],
                         capture_output=True, text=True)
    return run.returncode == 0


def values(p12, given):
    return {
        "MACOS_CERTIFICATE": base64.b64encode(p12.read_bytes()).decode(),
        "MACOS_CERTIFICATE_PWD": given["p12_pwd"],
        "KEYCHAIN_PASSWORD": secrets.token_urlsafe(24),
        "APPLE_ID": given["apple_id"],
        "APPLE_ID_PWD": given["app_pwd"],
    }


def upload(repo, named):
    failed = 0
    for name, value in named.items():
        run = subprocess.run(["gh", "secret", "set", name, "-R", repo],
                             input=value, capture_output=True, text=True)
        failed += run.returncode != 0
        state = "set" if run.returncode == 0 else run.stderr.strip()
        print(f"  {name} ({len(value)} chars) {state}")
    return 1 if failed else 0


def publish(p12, repo):
    given = ask()
    text = certificates(p12, given["p12_pwd"])
    found = re.findall(r"subject=.*", text)
    for line in found:
        print(f"  in the p12: {line}")
    team = team_of(text)
    status = 1
    if len(found) > 1:
        print(f"secrets: {p12} holds {len(found)} certificates. Export "
              "only the Developer ID Application identity.")
    elif not team:
        print(f"secrets: no Developer ID Application certificate in {p12}, "
              "or a wrong p12 password")
    elif not notary_accepts(given, team):
        print(f"secrets: notarytool history refused {given['apple_id']} "
              f"for team {team}")
    else:
        print(f"secrets: team {team}, notary credentials accepted")
        status = upload(repo, values(p12, given))
    return status


def main(argv):
    p12 = pathlib.Path(argv[1]) if len(argv) > 1 else None
    repo = argv[2] if len(argv) > 2 else REPO
    status = 2
    if p12 is None or not p12.is_file():
        print(__doc__)
    elif not repo_exists(repo):
        print(f"secrets: {repo} does not exist or gh cannot see it")
        status = 1
    else:
        status = publish(p12, repo)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv))
